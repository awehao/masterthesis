<robot name="omni_bot">
  <!-- ===================================================================
       Kinematics / physics port (ROS1 Gazebo-Classic -> ROS2 gz Harmonic):
       - Base moves at the /cmd_vel (body twist) level via gz VelocityControl,
         reusing ammr_bringup/omni_drive_controller for /odom + TF.
       - Omni wheels (rim + rollers) are VISUAL ONLY.
       - The robot rests on 4 hidden, zero-friction spherical "wheels" so the
         base glides under VelocityControl (mirrors the verified ammr_base).
       Effective wheel radius ~0.05 m -> base_link sits 0.05 m above ground.
       =================================================================== -->
  <!-- base_footprint: root, on the ground (odom child frame) -->
  <link name="base_footprint">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
  </joint>
  <!-- Chassis body (visual = original mesh, collision = simple raised box) -->
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.14"/>
      <!-- Length 0.28, not 0.18. The visual mesh spans z 0.000 to 0.280 in this
           frame and reaches the full 0.300 radius at BOTH ends: a wide bottom
           disc over z 0.000-0.080 and a wide top plate over z 0.260-0.280, with
           only the narrow column at z 0.180-0.200 (r 0.110) in between. A
           0.18-long cylinder centred at 0.14 covered z 0.050-0.230 and left
           1386 of the mesh's 2688 vertices, 51.6%, outside the collision body
           entirely — including both full-radius ends. Filling the column
           region out to 0.300 over-approximates that one band, which is the
           conservative direction; leaving the ends uncovered was not. -->
      <mass value="18.0"/>
      <inertia ixx="0.5229" ixy="0.0" ixz="0.0" iyy="0.5229" iyz="0.0" izz="0.81"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/howardchen/masterthesis/install/my_omnibot_description/share/my_omnibot_description/meshes/chassis_frame.stl" scale="1 1 1"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.15 0.45 0.85 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.14"/>
      <!-- Length 0.28, not 0.18. The visual mesh spans z 0.000 to 0.280 in this
           frame and reaches the full 0.300 radius at BOTH ends: a wide bottom
           disc over z 0.000-0.080 and a wide top plate over z 0.260-0.280, with
           only the narrow column at z 0.180-0.200 (r 0.110) in between. A
           0.18-long cylinder centred at 0.14 covered z 0.050-0.230 and left
           1386 of the mesh's 2688 vertices, 51.6%, outside the collision body
           entirely — including both full-radius ends. Filling the column
           region out to 0.300 over-approximates that one band, which is the
           conservative direction; leaving the ends uncovered was not. -->
      <!-- The chassis is a DISC of radius 0.300 m: that is what the visual mesh
           measures (chassis_frame.stl reaches 0.300 in every 30 deg sector) and
           it is what the analysis uses to judge clearance. The collision body
           used to be a 0.45 x 0.45 box, half-extent 0.225, so the simulated
           robot was 7.5 cm smaller than the real one along its axes, and a
           reported contact shallower than 7.5 cm had not physically happened in
           gz at all. Over ~230 trials of the final configuration, 15 events
           were reported as contacts but only 4 were deeper than that gap, so
           the two measures disagreed about 11 of them.
           Note this makes the robot LARGER on its axes (0.300 vs 0.225) and
           slightly smaller on its diagonals (0.300 vs 0.225*sqrt(2) = 0.318),
           so earlier batches are not comparable to anything run after it. -->
      <geometry>
        <cylinder length="0.28" radius="0.300"/>
      </geometry>
    </collision>
  </link>
  <link name="rim_a_link">
    <inertial>
      <mass value="0.50"/>
      <inertia ixx="0.000131905" ixy="0.0" ixz="0.0" iyy="0.000131905" iyz="0.0" izz="0.000203"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.027" radius="0.0285"/>
      </geometry>
      <material name="rim_a_mat">
        <color rgba="0.2 0.7 0.2 1"/>
      </material>
    </visual>
  </link>
  <joint name="base_link_rim_a_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rim_a_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="0 -1.57 0" xyz="0.245 0 0"/>
