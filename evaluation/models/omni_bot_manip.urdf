  <link name="support_fx">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="support_fx_joint" type="fixed">
    <parent link="base_link"/>
    <child link="support_fx"/>
    <!-- Sphere CENTRE level with the rim centres, so its lowest point is
           the wheel contact line. It used to sit at -wheel_r with radius
           wheel_r, i.e. reaching 2*wheel_r below base_link while the rims
           reached only wheel_r: the spheres hung exactly one wheel radius
           below the wheels, so gz rested the model on the spheres and the
           visible wheels floated 0.05 m off the ground at every spawn height.
           base_footprint is defined as the ground contact frame, and with this
           origin the spheres span base_link [-0.05, +0.05] = base_footprint
           [0.00, 0.10], touching the ground exactly where the wheels do.
           The wheels remain VISUAL ONLY: contact is still four frictionless
           spheres and the base is still driven by VelocityControl, so this
           corrects ride height and nothing else. It does NOT make this a
           wheel-ground contact model, and says nothing about slip, traction
           or real braking. -->
    <origin rpy="0 0 0" xyz="0.245 0 0"/>
  </joint>
  <gazebo reference="support_fx">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <link name="support_bx">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="support_bx_joint" type="fixed">
    <parent link="base_link"/>
    <child link="support_bx"/>
    <!-- Sphere CENTRE level with the rim centres, so its lowest point is
           the wheel contact line. It used to sit at -wheel_r with radius
           wheel_r, i.e. reaching 2*wheel_r below base_link while the rims
           reached only wheel_r: the spheres hung exactly one wheel radius
           below the wheels, so gz rested the model on the spheres and the
           visible wheels floated 0.05 m off the ground at every spawn height.
           base_footprint is defined as the ground contact frame, and with this
           origin the spheres span base_link [-0.05, +0.05] = base_footprint
           [0.00, 0.10], touching the ground exactly where the wheels do.
           The wheels remain VISUAL ONLY: contact is still four frictionless
           spheres and the base is still driven by VelocityControl, so this
           corrects ride height and nothing else. It does NOT make this a
           wheel-ground contact model, and says nothing about slip, traction
           or real braking. -->
    <origin rpy="0 0 0" xyz="-0.245 0 0"/>
  </joint>
  <gazebo reference="support_bx">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
