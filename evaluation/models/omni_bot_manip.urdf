      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera name="base_camera">
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.3</near>
            <far>8.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>
  <!-- ===== Base velocity control: applies /cmd_vel Twist directly to base ===== -->
  <gazebo>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>
  </gazebo>
  <!-- ===== Ground-truth odometry (drift-free, from the sim's true pose) =====
       Replaces dead-reckoning: on this heavier / high-CoM model, integrating the
       commanded /cmd_vel diverged badly (odom ended ~40 m from truth -> AMCL made
       up-to-16 m jump corrections -> the robot wandered). OdometryPublisher emits
       the true pose-derived odometry on /odom_raw; odom_tf_broadcaster relays it
       to /odom and the odom->base_footprint TF. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>odom_raw</odom_topic>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>
