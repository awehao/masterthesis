  <!-- Arm attach point, verbatim from the real robot: base_link + (0.11, 0,
         0.28). Same values as mobile_manipulator.xacro (attach_xyz default) and
         fake_mobile_manipulator_modified.urdf (base_link_to_link_base) in the
         MastersThesis_ros tree.

         No mount structure is modelled, matching that reference, which bolts
         the arm straight to base_link. An earlier version of this file put the
         arm on a centred mast whose risers hid in the LiDAR sectors scan_relay
         already masks; that geometry does not survive the 0.11 m offset (the
         masked sectors stop intersecting the plate footprint), and the real
         bracket is not measured, so nothing is invented in its place. -->
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="link_base"/>
    <origin rpy="0 0 0" xyz="0.11 0 0.28"/>
  </joint>
