#usda 1.0

def "World"
{
    def Xform "door"
    {
        double xformOp:rotateZ = 0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "frame"
        {
            def Cube "wall_hinge_side" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                float physxCollision:contactOffset = 0.004
                float physxCollision:restOffset = 0
                double size = 2
                double3 xformOp:scale = (0.7425, 0.06, 1.2)
                double3 xformOp:translate = (-0.7575, 0.06, 1.2)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "wall_latch_side" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                float physxCollision:contactOffset = 0.004
                float physxCollision:restOffset = 0
                double size = 2
                double3 xformOp:scale = (0.75, 0.06, 1.2)
                double3 xformOp:translate = (1.75, 0.06, 1.2)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "leaf" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
        )
        {
            point3f physics:centerOfMass = (0.475, 0.02, 1.01)
            float3 physics:diagonalInertia = (2.6677334, 3.2683334, 0.6027333)
            float physics:mass = 8
            float physxRigidBody:angularDamping = 2
            float physxRigidBody:linearDamping = 0

            def Cube "leaf_box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                float physxCollision:contactOffset = 0.004
                float physxCollision:restOffset = 0
                double size = 2
                double3 xformOp:scale = (0.475, 0.02, 0.9999999999999999)
                double3 xformOp:translate = (0.475, 0.02, 1.0099999999999998)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "post0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                float physxCollision:contactOffset = 0.004
                float physxCollision:restOffset = 0
                double size = 2
                double3 xformOp:scale = (0.008, 0.02, 0.012)
                double3 xformOp:translate = (0.7150000000000001, -0.02, 0.85)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "post1" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                float physxCollision:contactOffset = 0.004
                float physxCollision:restOffset = 0
                double size = 2
                double3 xformOp:scale = (0.008, 0.02, 0.012)
                double3 xformOp:translate = (0.885, -0.02, 0.85)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cylinder "handle_bar" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token axis = "X"
                double height = 0.2
                rel material:binding:physics = </World/PhysicsMaterials/door_handle> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                float physxCollision:contactOffset = 0.004
                float physxCollision:restOffset = 0
                double radius = 0.013
                double3 xformOp:translate = (0.8, -0.04, 0.85)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def Cube "post_in0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                float physxCollision:contactOffset = 0.004
                float physxCollision:restOffset = 0
                double size = 2
                double3 xformOp:scale = (0.008, 0.02, 0.012)
                double3 xformOp:translate = (0.7150000000000001, 0.06, 0.85)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "post_in1" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                float physxCollision:contactOffset = 0.004
                float physxCollision:restOffset = 0
                double size = 2
                double3 xformOp:scale = (0.008, 0.02, 0.012)
                double3 xformOp:translate = (0.885, 0.06, 0.85)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cylinder "handle_bar_inner" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token axis = "X"
                double height = 0.2
                rel material:binding:physics = </World/PhysicsMaterials/door_handle> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                float physxCollision:contactOffset = 0.004
                float physxCollision:restOffset = 0
                double radius = 0.013
                double3 xformOp:translate = (0.8, 0.08, 0.85)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

        def PhysicsRevoluteJoint "hinge" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0
            float drive:angular:physics:maxForce = 0
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token physics:axis = "Z"
            rel physics:body1 = </World/door/leaf>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 1, 0, 0)
            quatf physics:localRot1 = (0, 1, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 110
            float physxJoint:jointFriction = 0
        }
    }

    def Scope "PhysicsMaterials"
    {
        def Material "door_handle" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 1
        }
    }
}

