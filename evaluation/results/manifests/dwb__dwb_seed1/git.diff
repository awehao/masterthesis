diff --git a/evaluation/record.sh b/evaluation/record.sh
index a7a2c17cf..6bdecd1b6 100755
--- a/evaluation/record.sh
+++ b/evaluation/record.sh
@@ -14,7 +14,7 @@ set -e
 
 if [[ $# -lt 2 ]]; then
     echo "usage: $0 METHOD RUN_TAG [DURATION_S]" >&2
