+            import sys as _sys
+            from pathlib import Path as _P
+            _ev = os.environ.get('YS_EVAL_DIR') or str(_P(__file__).resolve().parents[6] / 'evaluation')
+            if _ev not in _sys.path:
+                _sys.path.insert(0, _ev)
+            import yield_side as _YS
+            self._t_YS = _YS
