      </geometry>
      <material name="rim_a_mat">
        <color rgba="0.2 0.7 0.2 1"/>
      </material>
    </visual>
  </link>
  <joint name="base_link_rim_a_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rim_a_link"/>
