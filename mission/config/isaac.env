# Isaac 實跑專用：在 task.env 之後讀
START=1.5,-4.5,1.5708
RTF=0.5                   # 模擬速度上限（實際約 0.43；瓶頸是每物理步算圖）
SIM_LIMIT=700             # 模擬秒上限
B_DEADLINE_MS=120         # 控制期限
AHEAD_DIAG_DEADLINE_MS=120
DOOR_QP_RESERVE_MS=25
D2_WALL_LIMIT_S=3300
GMPC_GI_INC=1
D2_NO_CATCHUP=1
B_HO_LEAD=150
PLATFORM=desktop
ROS_DOMAIN_ID=99
RUNNER=evaluation/run_d2_isaac.sh
D2_RENDER_EVERY=1         # 每 N 個物理步算一次圖（1＝每步；模擬速度瓶頸）
D2_RENDER_BURST=1         # 讀相機前連續算圖步數（RENDER_EVERY>1 時用 3，避免深度與彩色錯位）
