# Isaac 實跑專用：在 task.env 之後讀
START=1.5,-4.5,1.5708
RTF=0.7                   # 模擬速度上限（11/24 第 123 趟目標 1.0 實得約 0.81；11/25 第 121、122、125、126 趟目標 1.0 時一拍 >50 ms 晚到停車 ⇒ 目標 0.8，每拍預算 62.5 ms；開門段由 D2_PACE 降到 0.35）；11/25 第 131、134 趟目標 0.8 仍偶發一拍 >61 ms ⇒ 0.7（每拍 71 ms）
SIM_LIMIT=700             # 模擬秒上限
B_DEADLINE_MS=120         # 控制期限
AHEAD_DIAG_DEADLINE_MS=120
DOOR_QP_RESERVE_MS=25
D2_WALL_LIMIT_S=3300
GMPC_GI_INC=1
D2_NO_CATCHUP=1
B_HO_LEAD=150
PLATFORM=desktop
ROS_DOMAIN_ID=99
RUNNER=evaluation/run_d2_isaac.sh
D2_RENDER_EVERY=20        # 每 N 個物理步算一次圖（相機 5 Hz 不變；只降視窗更新率）
D2_RENDER_BURST=2         # 讀相機前連續算圖步數（1 ⇒ 影格舊 0.3 s，門把估計收斂不了；第 115–117 趟）
D2_ZERO_DELAY=1           # Isaac zero-delay 設定（算圖完成才回傳，影像與狀態同幀）
D2_VP_RES=640x360         # 視窗 viewport 解析度（只影響觀看畫面）
D2_PACE=grasp:CLOSE=0.35,grasp:CONFIRM=0.35,grasp:READY=0.35,open=0.35,pass:UNBIND=0.35,pass:FINGERS=0.35,pass:RETREAT=0.35,pick:APPROACH=0.6   # 開門段目標 RTF（開門控制每拍最長 >100 ms；第 122 趟 0.45 晚到）；放手後解除／張爪／退開也 0.35（第 125 趟放手切回 1.0 後 0.65 s 一拍 50.9 ms 晚到）；取物接近 0.6（11/25 茶几側向拉近後接近段每拍 48–68 ms，第 131 趟 60.7 ms 晚到）
