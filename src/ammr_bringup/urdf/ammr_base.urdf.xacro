<?xml version="1.0"?>
<robot name="ammr_base" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Properties：60cm 直徑圓形底盤 + 4 全向輪（十字形：前後左右）-->
  <xacro:property name="base_radius"  value="0.30"/>
  <xacro:property name="base_height"  value="0.12"/>
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width"  value="0.05"/>
  <xacro:property name="wheel_dist"   value="0.26"/>   <!-- 輪心距底盤中心 -->

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- 圓形底盤本體 -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.356" ixy="0.0" ixz="0.0"
                           iyy="0.356" iyz="0.0"
                                       izz="0.675"/>
    </inertial>
  </link>

  <!-- ===== 左/右輪 macro（軸沿 Y，圓面朝左/右）===== -->
  <xacro:macro name="lr_wheel" params="name x y">
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}"/>
      <origin xyz="${x} ${y} ${-base_height/2}" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.8"/>
        <inertia ixx="0.002" ixy="0.0" ixz="0.0"
                             iyy="0.002" iyz="0.0"
                                         izz="0.003"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ===== 前/後輪 macro（軸沿 X，圓面朝前/後）===== -->
  <xacro:macro name="fb_wheel" params="name x y">
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}"/>
      <origin xyz="${x} ${y} ${-base_height/2}" rpy="0 ${pi/2} 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.8"/>
        <inertia ixx="0.002" ixy="0.0" ixz="0.0"
                             iyy="0.002" iyz="0.0"
                                         izz="0.003"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- 十字形佈局：左右輪沿 Y 軸，前後輪沿 X 軸 -->
  <xacro:lr_wheel name="left_wheel"  x="0"              y="${ wheel_dist}"/>
  <xacro:lr_wheel name="right_wheel" x="0"              y="${-wheel_dist}"/>
  <xacro:fb_wheel name="front_wheel" x="${ wheel_dist}"  y="0"/>
  <xacro:fb_wheel name="back_wheel"  x="${-wheel_dist}"  y="0"/>

  <!-- ===== LiDAR link ===== -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 ${base_height/2 + 0.05}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="black2"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Gazebo LiDAR sensor -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <frame_id>lidar_link</frame_id>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ===== 各輪獨立 Joint Velocity Controller ===== -->
  <gazebo>
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>left_wheel_joint</joint_name>
      <topic>/gz/left_wheel_vel</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>right_wheel_joint</joint_name>
      <topic>/gz/right_wheel_vel</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>front_wheel_joint</joint_name>
      <topic>/gz/front_wheel_vel</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>back_wheel_joint</joint_name>
      <topic>/gz/back_wheel_vel</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>
  </gazebo>

  <!-- Joint state publisher（供 odometry 使用）-->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

  <!-- 四輪摩擦力設定 -->
  <gazebo reference="left_wheel">  <mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel"> <mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="front_wheel"> <mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="back_wheel">  <mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

</robot>
