<?xml version="1.0"?>
<!--
  K2 局部通行門場景（2026-10-21）：只有地面。門框、牆、門扇、把手**不寫在這裡**，
  由 evaluation/door_asset_v2.py 依 door_local_v2.yaml 建進 Isaac 舞台（幾何單一來源）。
  不放傢俱與其他障礙；局部夾持測試不涉及導航。
-->
<sdf version="1.9">
  <world name="door_local">
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
