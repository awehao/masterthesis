<?xml version="1.0"?>
<package format="3">
  <name>ammr_navigation</name>
  <version>0.0.1</version>
  <description>AMMR - navigation stack with MPC local planner</description>
  <maintainer email="your@email.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Nav2 -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_core</depend>
  <depend>nav2_util</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>

  <!-- Messages -->
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Math -->
  <depend>eigen3_cmake_module</depend>

  <!-- QP solver -->
  <depend>osqp_vendor</depend>

  <!-- Python -->
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <plugin plugin_name="ammr_navigation" plugin_export_tag="nav2_core::Controller"
            plugin_file="plugins.xml"/>
  </export>
</package>
