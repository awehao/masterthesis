<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_omnibot_description</name>
  <version>0.1.0</version>
  <description>
    Realistic omni-wheel mobile base (roller wheels + 2D LiDAR + RGBD camera),
    ported from a ROS1/Gazebo-Classic package to ROS2 Jazzy + Gazebo Sim (Harmonic).
    Drives at the /cmd_vel (body twist) level via gz VelocityControl, reusing the
    verified ammr_bringup control/odometry stack.
  </description>
  <maintainer email="42124howard@gmail.com">Howard Chen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- control / odom / scan relay / world / map are reused from ammr_bringup -->
  <exec_depend>ammr_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
