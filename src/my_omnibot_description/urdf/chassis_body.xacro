<?xml version="1.0"?>
<!--
  base_link and the four omni wheels: the physical chassis, shared by the
  simulation model (omni_bot.urdf.xacro) and the whole-body kinematics model
  (omni_bot_wholebody.urdf.xacro).

  It lives in its own file because the two models MUST agree on it. The
  collision cylinder in particular is load-bearing for the results: its radius
  is what every clearance number in the evaluation is measured against, so a
  solver that planned against a different chassis than the one simulated would
  make those numbers mean nothing.

  Body text below is unchanged from where it used to sit inline in
  omni_bot.urdf.xacro.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find my_omnibot_description)/urdf/rim.xacro"/>

  <xacro:macro name="chassis_body" params="">
  <!-- Chassis body (visual = original mesh, collision = simple raised box) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="0.5229" ixy="0.0" ixz="0.0" iyy="0.5229" iyz="0.0" izz="0.81"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find my_omnibot_description)/meshes/chassis_frame.stl" scale="1 1 1"/>
      </geometry>
      <material name="chassis_blue"><color rgba="0.15 0.45 0.85 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <!-- The chassis is a DISC of radius 0.300 m: that is what the visual mesh
           measures (chassis_frame.stl reaches 0.300 in every 30 deg sector) and
           it is what the analysis uses to judge clearance. The collision body
           used to be a 0.45 x 0.45 box, half-extent 0.225, so the simulated
           robot was 7.5 cm smaller than the real one along its axes, and a
           reported contact shallower than 7.5 cm had not physically happened in
           gz at all. Over ~230 trials of the final configuration, 15 events
           were reported as contacts but only 4 were deeper than that gap, so
           the two measures disagreed about 11 of them.
           Note this makes the robot LARGER on its axes (0.300 vs 0.225) and
           slightly smaller on its diagonals (0.300 vs 0.225*sqrt(2) = 0.318),
           so earlier batches are not comparable to anything run after it. -->
      <geometry>
        <cylinder radius="0.300" length="0.18"/>
      </geometry>
    </collision>
  </link>

  <!-- ===== Omni wheels (visual decoration) ===== -->
  <xacro:rim name="a" parent="base_link" xyz="0.245 0 0"  rpy="0 -1.57 0"  color="0.2 0.7 0.2 1"/>
  <xacro:rim name="b" parent="base_link" xyz="0 0.245 0"  rpy="1.57 1.57 0" color="0.2 0.4 0.8 1"/>
  <xacro:rim name="c" parent="base_link" xyz="-0.245 0 0" rpy="0 1.57 0"   color="0.85 0.75 0.2 1"/>
  <xacro:rim name="d" parent="base_link" xyz="0 -0.245 0" rpy="-1.57 -1.57 0" color="0.8 0.2 0.2 1"/>
  </xacro:macro>
</robot>
