<?xml version='1.0'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    2D LiDAR.
    PORT NOTE: original used Gazebo-Classic libgazebo_ros_laser.so on /laser/scan.
    Replaced with gz Harmonic <sensor type="gpu_lidar"> publishing to /scan_raw,
    matching the verified ammr_base setup (bridged + scan_relay -> /scan).
  -->
  <xacro:macro name="lidar" params="parent xyz rpy">
    <link name="lidar_link">
      <inertial>
        <mass value="0.214"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000105074" iyy="0.000105074" izz="0.00013983"
                 ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="0.03615" length="0.0444"/>
        </geometry>
        <material name="lidar_mat"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.03615" length="0.0444"/>
        </geometry>
      </collision>
    </link>

    <joint name="${parent}_lidar_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="lidar_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/scan_raw</topic>
        <frame_id>lidar_link</frame_id>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
