<?xml version="1.0"?>
<!--
  ros2_control block for the Lite 6 under gz_ros2_control, with a TUCK start
  pose.

  Why not upstream's lite6.ros2_control.xacro: it declares
  <state_interface name="position"/> with no initial_value, so gz starts every
  joint at 0. The official "home" in the xArm SRDF is also all zeros, which is
  fine for a bench-mounted arm but on a mobile base it leaves the arm unfolded
  and hanging over the chassis. gz_ros2_control reads
  <param name="initial_value"> on the position state interface, so declaring the
  block here lets the robot spawn already tucked.

  TUCK pose, chosen with the real collision meshes (not just joint frames):
      joint2 -0.082, joint3 +0.089, joint5 +1.679, rest 0

  The problem it fixes: at the official all-zeros "home" the wrist (link6) bottoms
  out at z = 0.490 while the arm's own base housing (link_base) tops out at
  0.509, so the hand hangs 2 cm BELOW the base and reads as "inside" the mount.
  Rotating joint5 lifts the wrist clear.

  Verified with src/my_omnibot_description/scripts/find_tuck_pose.py:
      lowest moving link  0.527 m  (+0.018 above the arm base top)
      horizontal radius   0.155 m  (inside the 0.30 m chassis radius, so the
                                    costmap footprint used for navigation still
                                    covers the arm)
      highest point       0.828 m
  All-zeros for comparison: 0.490 / 0.143 / 0.820, i.e. the same envelope but
  dipping below the base.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- All zeros, not the previous tuck.
       The tuck pose (0, -0.082, 0.089, 0, 1.679, 0) is in self-collision, and
       not marginally: exact triangle tests put link1 against the gripper shell
       and against finger2 at 0.000 m, i.e. actually intersecting, with finger1
       at 1.6 mm. Sampled point clouds had reported 1 to 3 mm there for months
       because they never landed on the pair of triangles that cross.
       All zeros clears every non-excluded pair, with link_base to link5 the
       tightest at 8.79 mm. That is not a lot: joint3 going NEGATIVE from here
       reaches intersection within 0.05 rad, so any motion starting from this
       pose needs its direction checked first. -->
  <xacro:property name="tuck_j1" value="0.0"/>
  <xacro:property name="tuck_j2" value="0.0"/>
  <xacro:property name="tuck_j3" value="0.0"/>
  <xacro:property name="tuck_j4" value="0.0"/>
  <xacro:property name="tuck_j5" value="0.0"/>
  <xacro:property name="tuck_j6" value="0.0"/>

  <xacro:macro name="lite6_ros2_control_gz"
               params="prefix:='' ros2_control_plugin:='gz_ros2_control/GazeboSimSystem'
                       add_gripper:=false">

    <ros2_control name="${prefix}lite6_gz" type="system">
      <hardware>
        <plugin>${ros2_control_plugin}</plugin>
      </hardware>

      <xacro:macro name="arm_joint" params="num lower upper initial">
        <joint name="${prefix}joint${num}">
          <command_interface name="position">
            <param name="min">${lower}</param>
            <param name="max">${upper}</param>
          </command_interface>
          <command_interface name="velocity">
            <param name="min">-3.14</param>
            <param name="max">3.14</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">${initial}</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <xacro:arm_joint num="1" lower="${-2.0*pi}"  upper="${2.0*pi}"  initial="${tuck_j1}"/>
      <xacro:arm_joint num="2" lower="-2.61799"    upper="2.61799"    initial="${tuck_j2}"/>
      <xacro:arm_joint num="3" lower="-0.061087"   upper="5.235988"   initial="${tuck_j3}"/>
      <xacro:arm_joint num="4" lower="${-2.0*pi}"  upper="${2.0*pi}"  initial="${tuck_j4}"/>
      <xacro:arm_joint num="5" lower="-2.1642"     upper="2.1642"     initial="${tuck_j5}"/>
      <xacro:arm_joint num="6" lower="${-2.0*pi}"  upper="${2.0*pi}"  initial="${tuck_j6}"/>

      <!-- UFACTORY Lite 6 factory gripper. Only finger_joint1 is commanded:
           finger_joint2 carries a <mimic> tag in uflite_gripper.urdf.xacro and
           gz_ros2_control follows it from the URDF, so declaring it here as
           well would give two writers for one joint.

           Upstream's uflite_gripper.ros2_control.xacro is not reused because it
           opens a SECOND <ros2_control> system. Two systems means two hardware
           components in one gz world, and the arm and the gripper then come up
           independently: the gripper can be live while the arm is not. One
           system keeps them in step. -->
      <xacro:if value="${add_gripper}">
        <joint name="${prefix}finger_joint1">
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">0.0089</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
        </joint>
      </xacro:if>
    </ros2_control>

  </xacro:macro>

</robot>
