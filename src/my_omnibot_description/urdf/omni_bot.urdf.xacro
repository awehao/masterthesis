<?xml version='1.0'?>
<robot name="omni_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_camera" default="true"/>
  <!-- Phase 2: UFACTORY Lite 6 arm on a mast above the LiDAR. Default OFF so
       every existing navigation launch/benchmark keeps the exact validated
       robot; turn on with  use_arm:=true . -->
  <xacro:arg name="use_arm" default="false"/>
  <!-- Factory gripper on the arm. Default false: it adds a commanded joint and
       a mimic joint, and every existing navigation benchmark must keep running
       the exact robot it was validated on. -->
  <xacro:arg name="add_gripper" default="false"/>
  <xacro:arg name="arm_ros2_control_plugin" default="gz_ros2_control/GazeboSimSystem"/>

  <xacro:include filename="$(find my_omnibot_description)/urdf/lidar.xacro"/>

  <!-- ===================================================================
       Kinematics / physics port (ROS1 Gazebo-Classic -> ROS2 gz Harmonic):
       - Base moves at the /cmd_vel (body twist) level via gz VelocityControl,
         reusing ammr_bringup/omni_drive_controller for /odom + TF.
       - Omni wheels (rim + rollers) are VISUAL ONLY.
       - The robot rests on 4 hidden, zero-friction spherical "wheels" so the
         base glides under VelocityControl (mirrors the verified ammr_base).
       Effective wheel radius ~0.05 m -> base_link sits 0.05 m above ground.
       =================================================================== -->

  <xacro:property name="wheel_r"   value="0.05"/>
  <xacro:property name="wheel_off" value="0.245"/>

  <!-- base_footprint: root, on the ground (odom child frame) -->
  <link name="base_footprint">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_r}" rpy="0 0 0"/>
  </joint>

  <!-- Chassis body + the four omni wheels. Extracted to chassis_body.xacro so
       the whole-body kinematics model uses the same geometry; see that file. -->
  <xacro:include filename="$(find my_omnibot_description)/urdf/chassis_body.xacro"/>
  <xacro:chassis_body/>

  <!-- ===== Hidden zero-friction support wheels (collision only) ===== -->
  <xacro:macro name="support" params="name x y">
    <link name="support_${name}">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <collision>
        <geometry><sphere radius="${wheel_r}"/></geometry>
      </collision>
    </link>
    <joint name="support_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="support_${name}"/>
      <origin xyz="${x} ${y} ${-wheel_r}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="support_${name}">
      <mu1>0.0</mu1><mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:support name="fx" x="${wheel_off}"  y="0"/>
  <xacro:support name="bx" x="${-wheel_off}" y="0"/>
  <xacro:support name="ly" x="0" y="${wheel_off}"/>
  <xacro:support name="ry" x="0" y="${-wheel_off}"/>

  <!-- ===== Sensors ===== -->
  <xacro:lidar parent="base_link" xyz="0 0 0.2152" rpy="0 0 0"/>

  <xacro:if value="$(arg use_camera)">
    <xacro:include filename="$(find my_omnibot_description)/urdf/camera.xacro"/>
    <xacro:rs_camera parent="base_link" name="base_camera">
      <origin xyz="0.25 0 0.3" rpy="0 0 0"/>
    </xacro:rs_camera>
  </xacro:if>

  <!-- ===== Base velocity control: applies /cmd_vel Twist directly to base ===== -->
  <gazebo>
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>
  </gazebo>

  <!-- ===== Ground-truth odometry (drift-free, from the sim's true pose) =====
       Replaces dead-reckoning: on this heavier / high-CoM model, integrating the
       commanded /cmd_vel diverged badly (odom ended ~40 m from truth -> AMCL made
       up-to-16 m jump corrections -> the robot wandered). OdometryPublisher emits
       the true pose-derived odometry on /odom_raw; odom_tf_broadcaster relays it
       to /odom and the odom->base_footprint TF. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>odom_raw</odom_topic>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>

  <!-- ===== Phase 2: manipulator (UFACTORY Lite 6, 6-DOF) ================
       Attached at the real robot's mounting point, base_link + (0.11, 0, 0.28).
       Base 3 DOF (x, y, theta) + arm 6 DOF = 9 DOF against a 6-DOF SE(3)
       end-effector task -> 3 redundant DOF for whole-body coordination.
       ===================================================================== -->
  <xacro:if value="$(arg use_arm)">
    <!-- xarm_description expects these three globals. Upstream sets them in
         _private_macro.xacro with scope="parent", which only works when that
         file is pulled in from INSIDE a macro; included at robot level it
         raises "'dict' object has no attribute '_setitem'". Declaring them
         here directly is equivalent. -->
    <!-- is_ros2=false makes lite6_robot SKIP its own ros2_control block; we
         supply lite6_ros2_control_gz.xacro instead, which is identical except
         that it sets initial_value on the position state interfaces so the arm
         spawns already tucked instead of at all-zeros. -->
    <xacro:property name="is_ros2" value="false"/>
    <xacro:property name="use_xacro_load_yaml" value="true"/>
    <xacro:property name="use_len" value="true"/>
    <!-- shared link/material/gazebo helpers the lite6 macros call into
         (upstream pulls these in from xarm_device_macro.xacro) -->
    <xacro:include filename="$(find xarm_description)/urdf/common/common.material.xacro"/>
    <xacro:common_material prefix=""/>
    <!-- Absolute file:// path, because gz Harmonic cannot resolve package://
         (the same fix the omni_bot chassis and roller meshes needed). -->
    <xacro:property name="mesh_path" value="file://$(find xarm_description)/meshes"/>
    <xacro:property name="mesh_suffix" value="stl"/>
    <xacro:include filename="$(find xarm_description)/urdf/common/common.link.xacro"/>
    <xacro:include filename="$(find xarm_description)/urdf/common/common.gazebo.xacro"/>
    <xacro:include filename="$(find xarm_description)/urdf/lite6/lite6_robot_macro.xacro"/>

    <xacro:lite6_robot
      prefix=""
      ros2_control_plugin="$(arg arm_ros2_control_plugin)"
      kinematics_params_filename="$(find xarm_description)/config/kinematics/default/lite6_default_kinematics.yaml"/>

    <xacro:include filename="$(find my_omnibot_description)/urdf/lite6_ros2_control_gz.xacro"/>
    <xacro:lite6_ros2_control_gz prefix=""
      ros2_control_plugin="$(arg arm_ros2_control_plugin)"
      add_gripper="$(arg add_gripper)"/>

    <!-- Factory gripper. link_eef has to be declared here: upstream puts it in
         xarm_device_macro.xacro, which we do not include, and lite6.urdf.xacro
         has its copy commented out. Only the URDF half of the gripper is
         pulled in; the full uflite_gripper_macro also drags in its own
         ros2_control system, transmissions and a gazebo grasp-fix plugin, and
         the finger joint is already declared in our single ros2_control block. -->
    <xacro:if value="$(arg add_gripper)">
      <link name="link_eef"/>
      <joint name="joint_eef" type="fixed">
        <parent link="link6"/>
        <child link="link_eef"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
      <xacro:include filename="$(find xarm_description)/urdf/gripper/uflite_gripper.urdf.xacro"/>
      <xacro:uflite_gripper_urdf prefix="" attach_to="link_eef"/>
    </xacro:if>

    <!-- Arm attach point, verbatim from the real robot: base_link + (0.11, 0,
         0.28). Same values as mobile_manipulator.xacro (attach_xyz default) and
         fake_mobile_manipulator_modified.urdf (base_link_to_link_base) in the
         MastersThesis_ros tree.

         No mount structure is modelled, matching that reference, which bolts
         the arm straight to base_link. An earlier version of this file put the
         arm on a centred mast whose risers hid in the LiDAR sectors scan_relay
         already masks; that geometry does not survive the 0.11 m offset (the
         masked sectors stop intersecting the plate footprint), and the real
         bracket is not measured, so nothing is invented in its place. -->
    <joint name="arm_base_joint" type="fixed">
      <parent link="base_link"/>
      <child link="link_base"/>
      <origin xyz="0.11 0 0.28" rpy="0 0 0"/>
    </joint>

    <!-- Observation frames for arm avoidance. Massless and geometry-free, so
         gz lumps them into the parent link and physics is unchanged; they exist
         only so robot_state_publisher puts them on TF for
         ammr_wholebody_mpc/arm_detection_points.py. Shared with
         omni_bot_wholebody.urdf.xacro so both models agree by construction. -->
    <xacro:include filename="$(find my_omnibot_description)/urdf/arm_detect_points.xacro"/>
    <xacro:arm_detect_points/>

    <!-- runs a controller_manager inside gz so the 6 arm joints are simulated
         at the physics rate. The base keeps using gz VelocityControl on
         /cmd_vel, so the validated navigation stack is untouched. -->
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find my_omnibot_description)/config/lite6_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
